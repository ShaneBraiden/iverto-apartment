{
  "expo": {
    "name": "Iverto Gate",
    "slug": "iverto-gate",
    "version": "0.3.0",
    "orientation": "portrait",
    "scheme": "ivertogate",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3F3F3"
    },
    "assetBundlePatterns": ["assets/*.png"],
    "android": {
      "package": "com.iverto.gate",
      "googleServicesFile": "./google-services.json",
      "versionCode": 3,
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F3F3F3"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.iverto.gate"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#B9000E"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "The guard scans a guest's pass and photographs visitors at the gate, so the household can see who is asking to come in.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Iverto Gate never reads your library — this is only here because the camera picker declares it.",
          "cameraPermission": "The guard app photographs every visitor at the gate, so the household can see who is asking to come in."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "buildArchs": ["armeabi-v7a", "arm64-v8a"],
            "enableMinifyInReleaseBuilds": false,
            "enablePngCrunchInReleaseBuilds": true
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "https://gate.iverto.ai/apt"
    }
  }
}
