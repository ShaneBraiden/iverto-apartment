# Where this build talks to. Read at bundle time by `lib/api/config.ts`.
#
# Expo inlines any variable prefixed with EXPO_PUBLIC_ into the JS bundle, so
# these are *not* secrets — they are the address of the service, visible to
# anyone with the APK. Never put a token or a key in this file.
#
# Copy to `.env` and edit. Restart Metro after changing it: the value is
# compiled in, so a running bundler will keep serving the old one.

# The service origin. No trailing slash, and no /api/v1 — `API_PREFIX` in
# config.ts carries that.
#
#   Deployed:                            https://gate.iverto.ai/apt
#   Android emulator reaching a laptop:  http://10.0.2.2:8031
#   Physical device on the same wifi:    http://192.168.1.x:8031
EXPO_PUBLIC_API_URL=https://gate.iverto.ai/apt

# Optional. Socket.IO connects to EXPO_PUBLIC_API_URL unless this overrides it,
# and it wants an http(s) origin — Socket.IO negotiates its own upgrade to a
# websocket, so do not write ws:// here.
# EXPO_PUBLIC_WS_URL=https://gate.iverto.ai/apt
